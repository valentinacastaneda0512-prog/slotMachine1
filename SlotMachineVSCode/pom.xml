<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. Identidad del proyecto -->
    <groupId>edu.eci.dopo</groupId>
    <artifactId>slotMachine</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <!-- 2. Configuración general -->
    <properties>
        <!-- Compila como Java 21 para que JaCoCo y PMD lo entiendan -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Los comentarios tienen tildes y ñ -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- 3. Librerías que usa el proyecto -->
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 4. Herramientas que se ejecutan al construir -->
    <build>
        <plugins>

            <!-- Compilador de Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Ejecuta las pruebas de unidad -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Las de aceptación se ejecutan aparte, a mano, porque abren el Canvas -->
                    <excludes>
                        <exclude>**/*AcceptanceTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- JaCoCo: análisis dinámico (cubrimiento de pruebas) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <!-- No revisar las clases internas de Java, solo las nuestras -->
                    <excludes>
                        <exclude>sun/**</exclude>
                        <exclude>jdk/**</exclude>
                        <exclude>com/sun/**</exclude>
                        <exclude>java/**</exclude>
                        <exclude>javax/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- PMD: análisis estático (reglas de calidad) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.26.0</version>
                <configuration>
                    <targetJdk>21</targetJdk>
                    <minimumPriority>5</minimumPriority>
                    <includeTests>false</includeTests>
                    <rulesets>
                        <ruleset>/rulesets/java/quickstart.xml</ruleset>
                    </rulesets>
                </configuration>
            </plugin>

        </plugins>
    </build>
</project>
